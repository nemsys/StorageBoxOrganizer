<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android 12+ system splash icon. Same artwork as public/box.svg (lucide
    package-open) in the same blue, so the system splash, the Capacitor splash
    and the web launch screen are one picture.

    The platform draws this drawable at 288dp and masks it to the inner 192dp,
    so the 24x24 artwork sits on a 46x46 viewport (inset 11 a side). That puts
    the visible box at ~150dp — what AppIntro draws on a phone — and well inside
    the mask, so nothing is clipped and nothing jumps at the hand-over.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="46"
    android:viewportHeight="46">
    <group android:translateX="11" android:translateY="11">
        <path
            android:pathData="M12 22v-9"
            android:strokeColor="#38bdf8"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M15.17 2.21a1.67 1.67 0 0 1 1.63 0L21 4.57a1.93 1.93 0 0 1 0 3.36L8.82 14.79a1.655 1.655 0 0 1-1.64 0L3 12.43a1.93 1.93 0 0 1 0-3.36z"
            android:strokeColor="#38bdf8"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M20 13v3.87a2.06 2.06 0 0 1-1.11 1.83l-6 3.08a1.93 1.93 0 0 1-1.78 0l-6-3.08A2.06 2.06 0 0 1 4 16.87V13"
            android:strokeColor="#38bdf8"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M21 12.43a1.93 1.93 0 0 0 0-3.36L8.83 2.2a1.64 1.64 0 0 0-1.63 0L3 4.57a1.93 1.93 0 0 0 0 3.36l12.18 6.86a1.636 1.636 0 0 0 1.63 0z"
            android:strokeColor="#38bdf8"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
