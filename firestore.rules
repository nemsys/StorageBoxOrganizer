rules_version = '2';

// Firestore security rules for Storage Box Organizer.
//
// Every document carries a `userId`; a signed-in client may only touch its own.
// This is what makes several people share one Firebase project safely — each
// signs up with their own account and the database itself, not just the UI,
// keeps the data apart.
//
// Deployed with `firebase deploy --only firestore:rules` (or as part of
// `npm run deploy`). Kept in the repo so the live ruleset is versioned and
// recoverable rather than living only in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable checks
    function isSignedIn() { return request.auth != null; }
    function owns(res)    { return isSignedIn() && request.auth.uid == res.data.userId; }
    function ownsNew()    { return isSignedIn() && request.resource.data.userId == request.auth.uid; }

    match /boxes/{boxId} {
      allow read, delete: if owns(resource);
      allow create:       if ownsNew();
      allow update:       if owns(resource) && ownsNew();   // can't change owner
    }

    match /items/{itemId} {
      allow read, delete: if owns(resource);
      allow create:       if ownsNew();
      allow update:       if owns(resource) && ownsNew();
    }

    match /images/{imageId} {
      allow read, delete: if owns(resource);
      allow create:       if ownsNew();
      allow update:       if owns(resource) && ownsNew();
    }
  }
}
