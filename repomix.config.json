{
  "output": {
    "filePath": "repomix-output.txt",
    "style": "xml",
    "parsable": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".backups",
      ".backups/**",
      ".firebase",
      ".firebase/**",
      ".secrets",
      ".secrets/**",
      "dist",
      "dist/**",
      "node_modules",
      "node_modules/**",
      "package-lock.json",
      "temp_backup",
      "temp_backup/**",
      "repomix-output.*"
    ]
  }
}
